{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai-plan-1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "done_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "enum": ["host", "luna", "luna_construction", "terra", "sol_planner", "sol_reviewer", "sol_xhigh", "sol_medium_supervisor", "terra_xhigh", "sol_medium_reviewer", "sol_xhigh_planner"]
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "do_not_touch": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "verification_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "first_artifact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_level": {
            "type": "string",
            "enum": ["L0", "L1", "L2"]
          },
          "construction_envelope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowed_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "done_when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {"const": "TEST"},
                  "command": {"type": "string", "minLength": 1},
                  "expected_exit": {"type": "integer", "const": 0},
                  "assertion": {"type": "string", "minLength": 1},
                  "artifact": {"type": "string", "minLength": 1}
                },
                "required": ["kind", "command", "expected_exit", "assertion", "artifact"]
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "L0": {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "HASH"}, "artifact": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["kind", "artifact", "sha256"]},
                  "L1": {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "COMMAND"}, "command": {"type": "string", "minLength": 1}, "expected_exit": {"type": "integer", "const": 0}, "assertion": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}}, "required": ["kind", "command", "expected_exit", "assertion", "artifact"]},
                  "L2": {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "TEST"}, "command": {"type": "string", "minLength": 1}, "expected_exit": {"type": "integer", "const": 0}, "assertion": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}}, "required": ["kind", "command", "expected_exit", "assertion", "artifact"]}
                },
                "required": ["L0", "L1", "L2"]
              },
              "negative_checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "COMMAND"}, "command": {"type": "string", "minLength": 1}, "expected_exit": {"type": "integer", "not": {"const": 0}}, "assertion": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}}, "required": ["kind", "command", "expected_exit", "assertion", "artifact"]}
              },
              "risk_classification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {"const": "LOCAL_DETERMINISTIC_IMPLEMENTATION"},
                  "security": {"const": false},
                  "authorization": {"const": false},
                  "protocol": {"const": false},
                  "control_plane": {"const": false}
                },
                "required": ["kind", "security", "authorization", "protocol", "control_plane"]
              }
            },
            "required": ["allowed_paths", "done_when", "evidence", "negative_checks", "risk_classification"]
          }
        },
        "required": [
          "id",
          "owner_role",
          "read_scope",
          "write_scope",
          "do_not_touch",
          "depends_on",
          "expected_result",
          "verification_commands",
          "first_artifact",
          "evidence_level"
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "goal",
    "done_when",
    "tasks",
    "stages"
  ]
}
