{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai-plan-1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "done_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "enum": ["host", "luna", "luna_construction", "terra", "sol_planner", "sol_reviewer", "sol_xhigh", "sol_medium_supervisor", "terra_xhigh", "sol_medium_reviewer", "sol_xhigh_planner"]
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "do_not_touch": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "verification_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "first_artifact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_level": {
            "type": "string",
            "enum": ["L0", "L1", "L2"]
          },
          "construction_envelope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowed_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "done_when": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "L0": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "L1": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "L2": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                },
                "required": ["L0", "L1", "L2"]
              },
              "negative_checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "required": ["allowed_paths", "done_when", "evidence", "negative_checks"]
          }
        },
        "required": [
          "id",
          "owner_role",
          "read_scope",
          "write_scope",
          "do_not_touch",
          "depends_on",
          "expected_result",
          "verification_commands",
          "first_artifact",
          "evidence_level"
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "goal",
    "done_when",
    "tasks",
    "stages"
  ]
}
