{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai-candidate-state-1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "envelope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "captured_at_utc": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "envelope_hash",
    "candidate_commit",
    "baseline_commit",
    "tree_digest",
    "diff_digest",
    "runtime_evidence_ids",
    "captured_at_utc"
  ]
}
