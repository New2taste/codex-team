{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai-route-declaration-1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "envelope_hash": {
      "type": "string",
      "minLength": 1
    },
    "router_version": {
      "type": "string",
      "const": "deterministic-router-1"
    },
    "route_config_hash": {
      "type": "string",
      "minLength": 1
    },
    "selected_route": {
      "type": "string",
      "enum": ["direct", "sol_only", "delegated", "blocked"]
    },
    "allowed_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "host",
          "luna",
          "luna_construction",
          "sol_medium_reviewer",
          "sol_medium_supervisor",
          "sol_planner",
          "sol_reviewer",
          "sol_xhigh",
          "sol_xhigh_planner",
          "terra",
          "terra_xhigh",
          "terra_xhigh_planner",
          "terra_xhigh_reviewer"
        ]
      }
    },
    "active_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "host",
          "luna",
          "luna_construction",
          "sol_medium_reviewer",
          "sol_medium_supervisor",
          "sol_planner",
          "sol_reviewer",
          "sol_xhigh",
          "sol_xhigh_planner",
          "terra",
          "terra_xhigh",
          "terra_xhigh_planner",
          "terra_xhigh_reviewer"
        ]
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_dispatches": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from_role": {
            "type": "string",
            "minLength": 1
          },
          "to_role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["from_role", "to_role"]
      }
    },
    "declared_at_utc": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "envelope_hash",
    "router_version",
    "route_config_hash",
    "selected_route",
    "allowed_roles",
    "active_roles",
    "rule_ids",
    "reason_codes",
    "max_dispatches",
    "allowed_transitions",
    "declared_at_utc"
  ]
}
